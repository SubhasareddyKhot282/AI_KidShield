# Server
PORT=5001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-kid-shield

# Encrypt OAuth refresh tokens at rest
# Use any strong secret; it will be hashed to a 32-byte AES key.
TOKEN_ENCRYPTION_KEY=change-this-to-a-long-random-string

# Single shared key for child device to call alert + upload endpoints
# (Production: use per-device tokens / per-user API keys.)
CHILD_API_KEY=replace-me

